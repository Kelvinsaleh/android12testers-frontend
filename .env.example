# Vercel frontend settings. Do not put DATABASE_URL, Paystack keys, or R2 credentials here.
NEXT_PUBLIC_SITE_URL=https://android12testers.com
NEON_AUTH_BASE_URL=https://ep-sparkling-tree-bdsqsqc8.neonauth.c-8.us-east-2.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-sparkling-tree-bdsqsqc8.neonauth.c-8.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-a-random-secret-at-least-32-characters
BACKEND_API_URL=https://YOUR-RENDER-SERVICE.onrender.com
# Must be exactly the same secret in Vercel and Render. Generate with: openssl rand -base64 48
BACKEND_PROXY_SECRET=generate-one-shared-random-secret-at-least-32-characters

# Optional local development example:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# BACKEND_API_URL=http://localhost:10000
