{
  "name": "android-testers-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/smoke-check.mjs",
    "check:security": "node scripts/security-check.mjs",
    "test": "npm run check:content && npm run check:security && node scripts/backend-contract-check.mjs",
    "check:backend": "node scripts/backend-contract-check.mjs",
    "smoke:production": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "0.7.0-beta",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@neondatabase/auth-ui": {
      "@neondatabase/auth": "$@neondatabase/auth"
    }
  }
}
