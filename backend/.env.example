# Render backend settings. Add each variable in Render Dashboard > Environment.
PORT=10000
# Use the NEW pooled connection string after rotating the exposed password.
# The API keeps sslmode=require and strips channel_binding=require because SQLx 0.8
# does not accept that libpq URL option; TLS remains mandatory.
DATABASE_URL=YOUR_NEW_ROTATED_NEON_POOLED_CONNECTION_STRING
# Must match BACKEND_PROXY_SECRET on Vercel. Never put this value in frontend code.
BACKEND_PROXY_SECRET=generate-one-shared-random-secret-at-least-32-characters
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret
# Generate a Paystack webhook signing secret (whsec_...) in Developers > API configuration.
# Set this for new Paystack-Signature headers. Multiple comma-separated secrets allow key rotation.
PAYSTACK_WEBHOOK_SECRET=whsec_replace_me
# Optional override for overlap/rotation; comma-separated active whsec_ secrets take precedence.
# PAYSTACK_WEBHOOK_SECRETS=whsec_current,whsec_previous
FRONTEND_URL=https://android12testers.com

# Cloudflare R2 is required for evidence screenshot uploads and administrator evidence previews.
# The API fails startup unless all four R2 settings are valid and the bucket is reachable.
# A valid PAYSTACK_WEBHOOK_SECRET (whsec_...) is also required at startup.
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_bucket_scoped_access_key
R2_SECRET_ACCESS_KEY=replace_with_bucket_scoped_secret
R2_BUCKET_NAME=android-testers-evidence

# Optional transactional email. Without these, dashboard workflows still work but notices are not emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Android Testers <notifications@android12testers.com>

# Informational only: the hosted Paystack payment page is not used for per-campaign checkout.
# PAYSTACK_SHOP_URL=https://paystack.shop/pay/ka5-epv4t1
